---
# Single source of truth for ALL per-cluster credentials AND identity.
# Each key MUST match the generated cluster name: {cluster_prefix}-{category}-{index}
# Seats are zero-padded: seat-01, seat-02, etc.
#
# ┌────────────────────────┬─────────────┬───────────┬───────────────┐
# │ Field                  │ Greenfield  │ AWS-Ready │ Cluster-Ready │
# ├────────────────────────┼─────────────┼───────────┼───────────────┤
# │ aws_access_key_id      │ REQUIRED    │ REQUIRED  │ REQUIRED      │
# │ aws_secret_access_key  │ REQUIRED    │ REQUIRED  │ REQUIRED      │
# │ aws_region             │ REQUIRED    │ REQUIRED  │ REQUIRED      │
# │ aws_account_id         │ Optional    │ Optional  │ Optional      │
# │ purpose                │ REQUIRED    │ REQUIRED  │ REQUIRED      │
# │ seat_number            │ REQUIRED *  │ REQUIRED *│ REQUIRED *    │
# │ enabled                │ Optional    │ Optional  │ Optional      │
# │ subnet_ids             │ Auto-created│ REQUIRED  │ Not used      │
# │ api_url                │ Auto-created│ Auto-created│ REQUIRED    │
# │ admin_password         │ Auto-created│ Auto-created│ REQUIRED    │
# └────────────────────────┴─────────────┴───────────┴───────────────┘
# * seat_number required only for clusters with purpose=attendee
#
# Scenarios:
#   make deploy-greenfield                           — builds everything from scratch
#   make deploy-aws-ready                            — AWS infra exists, provision ROSA + app
#   make deploy-cluster-ready INSTANCE_TYPE=m5.2xlarge — clusters running, add autoscaler + app
#
# Example for: prefix=lab, 1 facilitator, 1 hub, 3 seats

cluster_credentials:
  lab-facilitator-1:
    aws_access_key_id: "AKIAIOSFODNN7EXAMPLE"
    aws_secret_access_key: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
    aws_region: "us-east-2"
    aws_account_id: "111111111111"
    purpose: facilitator
    enabled: true
    api_url: ""
    admin_password: ""

  lab-hub-1:
    aws_access_key_id: "AKIAIOSFODNN7EXAMPLE"
    aws_secret_access_key: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
    aws_region: "us-east-2"
    aws_account_id: "222222222222"
    purpose: hub
    enabled: true
    api_url: ""
    admin_password: ""

  lab-seat-01:
    aws_access_key_id: "AKIAIOSFODNN7EXAMPLE"
    aws_secret_access_key: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
    aws_region: "us-east-2"
    aws_account_id: "333333333333"
    purpose: attendee
    seat_number: 1
    enabled: true
    api_url: ""
    admin_password: ""

  lab-seat-02:
    aws_access_key_id: "AKIAIOSFODNN7EXAMPLE"
    aws_secret_access_key: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
    aws_region: "us-east-2"
    aws_account_id: "444444444444"
    purpose: attendee
    seat_number: 2
    enabled: true
    api_url: ""
    admin_password: ""

  lab-seat-03:
    aws_access_key_id: "AKIAIOSFODNN7EXAMPLE"
    aws_secret_access_key: "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
    aws_region: "us-east-2"
    aws_account_id: "555555555555"
    purpose: attendee
