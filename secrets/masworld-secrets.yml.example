---
# MAS World secrets template — IBM credentials only.
#
# Copy this file to secrets/masworld-secrets.yml and replace placeholder values.
# DO NOT commit secrets/masworld-secrets.yml — it is gitignored.
#
# Per-cluster credentials (AWS keys, admin passwords, api_url) are stored in
# secrets/cluster-credentials.yml — the single source of truth for all
# per-cluster credentials.
#
# Values starting with file:// are read from the referenced file.
# Relative paths resolve from the secrets/ directory.
#
# Where to get these credentials:
#   IBM Entitlement Key:   https://myibm.ibm.com/products-services/containerlibrary
#   IBM MAS License:       https://www.ibm.com/software/passportadvantage/
#   OpenShift Pull Secret: https://console.redhat.com/openshift/install/pull-secret

# ── IBM credentials ───────────────────────────────────────────────────
ibm/entitlement-key: "file://entitlement.dat"
ibm/license: "file://license.dat"
registry/pull-secret: "file://pullsecret.json"
