---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: {{ masworld_lab_clusterrole_name }}
  labels:
    masworld.redhat.com/component: lab-accounts
rules:
  # Cluster-wide read access (exploration exercises)
  - apiGroups: [""]
    resources: [nodes, namespaces, persistentvolumes]
    verbs: [get, list, watch]
  - apiGroups: ["config.openshift.io"]
    resources: [clusterversions, clusteroperators, infrastructures, oauths, ingresses, operatorhubs, authentications]
    verbs: [get, list, watch]
  - apiGroups: ["operator.openshift.io"]
    resources: [cloudcredentials]
    verbs: [get, list, watch]
  - apiGroups: ["machineconfiguration.openshift.io"]
    resources: [machineconfigpools]
    verbs: [get, list, watch]

  # Read MAS CRDs (click-through, no modifications)
  - apiGroups: ["core.mas.ibm.com"]
    resources: ["*"]
    verbs: [get, list, watch]
  - apiGroups: ["apps.mas.ibm.com"]
    resources: ["*"]
    verbs: [get, list, watch]

  # OLM read cluster-wide (navigation exercise)
  - apiGroups: ["operators.coreos.com"]
    resources: [subscriptions, clusterserviceversions, installplans, operatorgroups, catalogsources, operators, olmconfigs, operatorconditions]
    verbs: [get, list, watch]
  # OLM write cluster-wide (console checks cluster-scoped create subscriptions to show Software Catalog)
  - apiGroups: ["operators.coreos.com"]
    resources: [subscriptions, operatorgroups]
    verbs: [create, update, patch, delete]
  - apiGroups: ["packages.operators.coreos.com"]
    resources: [packagemanifests, packagemanifests/icon]
    verbs: [get, list, watch]

  # Read pods, services, events cluster-wide
  - apiGroups: [""]
    resources: [pods, pods/log, services, configmaps, events, secrets, serviceaccounts, persistentvolumeclaims]
    verbs: [get, list, watch]
  - apiGroups: ["apps"]
    resources: [deployments, statefulsets, daemonsets, replicasets]
    verbs: [get, list, watch]
  - apiGroups: ["route.openshift.io"]
    resources: [routes]
    verbs: [get, list, watch]
  - apiGroups: ["rbac.authorization.k8s.io"]
    resources: [roles, rolebindings, clusterroles, clusterrolebindings]
    verbs: [get, list, watch]

  # OpenShift group sync (identity exercise)
  - apiGroups: ["user.openshift.io"]
    resources: [groups, users, identities]
    verbs: [get, list, watch, create, update, patch, delete]

  # COO UIPlugin (cluster-scoped, observability exercise)
  - apiGroups: ["observability.openshift.io"]
    resources: [uiplugins]
    verbs: [get, list, watch, create, update, patch, delete]

  # Namespace creation (identity exercise — group-sync-operator)
  - apiGroups: [""]
    resources: [namespaces]
    verbs: [create, update, patch]

  # Pod management (observability exercise — Manage pod delete for persistent logging)
  - apiGroups: [""]
    resources: [pods]
    verbs: [delete]

  # ServiceAccount management (observability exercise — collector SA)
  - apiGroups: [""]
    resources: [serviceaccounts]
    verbs: [create, update, patch, delete]

  # ClusterRoleBinding management (observability exercise — collector SA bindings)
  - apiGroups: ["rbac.authorization.k8s.io"]
    resources: [clusterrolebindings]
    verbs: [create, update, patch, delete]

  # Group Sync Operator CRD (identity exercise)
  - apiGroups: ["redhatcop.redhat.io"]
    resources: [groupsyncs]
    verbs: [get, list, watch, create, update, patch, delete]

  # Software Catalog (OCP 4.17+ unified Ecosystem > Software Catalog page)
  - apiGroups: ["template.openshift.io"]
    resources: [templates, templateinstances, brokertemplateinstances]
    verbs: [get, list, watch]
  - apiGroups: ["helm.openshift.io"]
    resources: [helmchartrepositories, projecthelmchartrepositories]
    verbs: [get, list, watch]
  - apiGroups: ["console.openshift.io"]
    resources: [consolequickstarts, consolesamples, consoleplugins]
    verbs: [get, list, watch]

  # Self-access for auth checks
  - apiGroups: ["authorization.openshift.io"]
    resources: [selfsubjectrulesreviews]
    verbs: [create]
  - apiGroups: ["authorization.k8s.io"]
    resources: [selfsubjectaccessreviews, selfsubjectrulesreviews]
    verbs: [create]
